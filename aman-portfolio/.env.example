# Server-side Ask Aman configuration. Do not use VITE_ prefixes for these values.
GEMINI_API_KEY=replace_with_server_side_gemini_api_key
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=20
ASK_AMAN_MAX_QUESTION_LENGTH=300
ASK_AMAN_MAX_REQUEST_BODY_BYTES=16384
ASK_AMAN_RATE_LIMIT=8
ASK_AMAN_RATE_WINDOW_SECONDS=60
APP_ENV=development
